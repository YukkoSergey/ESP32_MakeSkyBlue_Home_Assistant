#ifndef SECRETS_H
#define SECRETS_H

// WiFi
#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// -----------------------------------------------------------------------------
// MQTT — two brokers
// -----------------------------------------------------------------------------
// LAN broker where Solar Assistant publishes solar_assistant/**.
// ESP32 subscribes here to forward MUST state to Tuya virtual device.
#define MQTT_LAN_HOST     "192.168.1.10"
#define MQTT_LAN_PORT     1883
#define MQTT_LAN_USERNAME "YOUR_LAN_MQTT_USER"
#define MQTT_LAN_PASSWORD "YOUR_LAN_MQTT_PASSWORD"

// Home Assistant broker (VPS mosquitto) where Solar_Manager listens for
// msbN/notify, msbN/online, msbN/diagnostics.
#define MQTT_HA_HOST      "broker.example.com"
#define MQTT_HA_PORT      1883
#define MQTT_HA_USERNAME  "YOUR_HA_MQTT_USER"
#define MQTT_HA_PASSWORD  "YOUR_HA_MQTT_PASSWORD"

// -----------------------------------------------------------------------------
// Tuya Cloud
// -----------------------------------------------------------------------------
#define TUYA_CLIENT_ID     "YOUR_TUYA_CLIENT_ID"
#define TUYA_CLIENT_SECRET "YOUR_TUYA_CLIENT_SECRET"
#define TUYA_API_BASE_URL  "https://openapi.tuyaeu.com"

// Virtual MUST device (Solar Assistant -> Tuya cloud DP publish target)
#define TUYA_MUST_DEVICE_ID "YOUR_MUST_DEVICE_ID"
#define TUYA_VIRTUAL_ID     TUYA_MUST_DEVICE_ID

// Physical MakeSkyBlue MPPT devices (Tuya cloud -> read via API)
#define TUYA_MPPT_1_ID "YOUR_MPPT_1_ID"
#define TUYA_MPPT_2_ID "YOUR_MPPT_2_ID"
#define TUYA_MPPT_3_ID "YOUR_MPPT_3_ID"

// -----------------------------------------------------------------------------
// Solar_Manager serials — must match config_entries in Home Assistant.
// Currently HA is configured with msb1/msb2/msb3.
// -----------------------------------------------------------------------------
#define MSB_SERIAL_1 "msb1"
#define MSB_SERIAL_2 "msb2"
#define MSB_SERIAL_3 "msb3"

#endif
